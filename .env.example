# ─── App ────────────────────────────────────────────────────────────────
# Public base URL of the site (no trailing slash)
APP_URL="http://localhost:3000"

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dion?schema=public"

# ─── Auth.js (NextAuth) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Required when running on localhost / behind a proxy that Auth.js doesn't recognize
AUTH_TRUST_HOST="true"

# ─── Email / SMTP ───────────────────────────────────────────────────────
# Leave empty in development: verification & password-reset emails are
# printed to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Dion Technologies <no-reply@diontechnologies.com>"

# ─── Stripe ─────────────────────────────────────────────────────────────
# Leave empty to run the site with billing disabled — Stripe routes respond
# with a clear "not configured" message until these are set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring price ID for the premium subscription (price_...)
STRIPE_PRICE_ID=""
# Optional: preset Connect Express account ID; otherwise created on first onboarding
STRIPE_CONNECT_ACCOUNT_ID=""
STRIPE_CONNECT_COUNTRY="US"

# ─── First admin account (used by `npm run db:seed`) ────────────────────
# Defaults in development: admin@dion.local / ChangeMe-2026! — override for production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

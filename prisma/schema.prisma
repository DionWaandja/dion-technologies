generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
  HANDLED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  passwordHash         String
  name                 String?
  company              String?
  role                 Role               @default(CLIENT)
  emailVerified        DateTime?
  sessionVersion       Int                @default(0)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(NONE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  messages                Message[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([subscriptionStatus])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Message {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  description String
  budgetRange String
  status      MessageStatus @default(NEW)
  notes       String?
  handledAt   DateTime?
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorEmail String?
  ip         String?
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail])
}

// Simple key/value store for non-sensitive platform settings
// (e.g. the Stripe Connect Express account id). Never store bank details here.
model Setting {
  key   String @id
  value String
}
